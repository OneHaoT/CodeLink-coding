# ============================================
# CodeLink 环境变量模板
# 使用方式：复制本文件为 .env 并填入真实值（.env 已被 .gitignore 排除，严禁提交）
# 寻址类变量（HOST/PORT/URI）有占位默认值，部署时按实际中间件地址填写
# 凭据类变量（USER/PWD/SECRET）无默认值，必须填写，缺失时应用启动快速失败
# ============================================

# --- MySQL ---
DB_HOST=<your-mysql-host>
DB_PORT=3306
DB_NAME=codeknest
DB_USER=
DB_PWD=

# --- Redis ---
REDIS_HOST=<your-redis-host>
REDIS_PORT=6379
REDIS_PWD=

# --- RabbitMQ ---
RABBITMQ_HOST=<your-rabbitmq-host>
RABBITMQ_PORT=5672
RABBITMQ_VHOST=/CodeLink
RABBITMQ_USER=
RABBITMQ_PWD=

# --- MongoDB（草稿 / 登录日志，见开发文档 §4.7）---
MONGO_HOST=<your-mongodb-host>
MONGO_PORT=27017
MONGO_USER=
MONGO_PWD=

# --- Elasticsearch（无凭证，仅寻址）---
ES_URI=http://<your-es-host>:9200

# --- JWT（必须设置，长度至少 256 位）---
JWT_SECRET=

# --- 上传路径 ---
UPLOAD_PATH=./data/uploads
UPLOAD_URL_PREFIX=/api/files
IMAGE_PATH=./image
