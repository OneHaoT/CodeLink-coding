<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.codeknest</groupId>
        <artifactId>codeknest-backend</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>codeknest-module-account</artifactId>
    <name>CodeLink Module Account</name>
    <description>账号域 — 认证（auth）/ 用户（user）/ 消息通知（message）（阶段6由 3 模块合并）</description>

    <dependencies>
        <dependency>
            <groupId>com.codeknest</groupId>
            <artifactId>codeknest-common</artifactId>
        </dependency>
        <!-- 操作日志 / 用户动态（MongoDB 读侧投影） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-mongodb</artifactId>
        </dependency>
        <!-- 用户事件发布（登录/登出/注册/关注 → 统一事件通道） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-amqp</artifactId>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
