# ============================================
# CodeLink 公共模块 SPI 注册
# Spring Boot 3.4 的 EnvironmentPostProcessor 通过 spring.factories 加载
# （EnvironmentPostProcessorsFactory → SpringFactoriesEnvironmentPostProcessorsFactory；
#   META-INF/spring/*.imports 只对自动配置生效，对 EnvironmentPostProcessor 无效）
# ============================================

# 部署自举：MySQL 库不存在时自动创建（幂等，已存在则跳过）
org.springframework.boot.env.EnvironmentPostProcessor=\
com.codeknest.common.init.DatabaseBootstrapPostProcessor
